// Cloudflare Workers config: serves site/ as static files. worker/index.js runs first for the
// v8 pages (to apply the doctor's edits), the booking/admin API, the admin area and uploaded photos.
{
  "name": "eternawell-new",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin/*", "/media/*", "/v8/*", "!/v8/assets/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "observability": { "enabled": true }
}
